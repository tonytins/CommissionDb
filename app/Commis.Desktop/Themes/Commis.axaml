<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- The window's buttons: flat, 46 wide, in the corner of the bar, as Windows draws them. -->
    <ControlTheme x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector=":is(TextBlock).title">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector=":is(TextBlock).secondary">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector=":is(TextBlock).problem">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinHeight" Value="26"/>
  </Style>

  <!-- Windows' red on the close button, so it reads as one. -->
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C"/>
  </Style>

  <Style Selector="ListBox.sections">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- The record list's column names. -->
  <Style Selector="TextBlock.header">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!-- The detail pane's rows are spaced by margins, so a hidden row, such as a commission's slot, leaves no gap. -->
  <Style Selector="Grid.fields > :is(Control)">
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <!-- A field's name in the detail pane. -->
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
  </Style>

  <!-- A selection uses the Selection role, in the sidebar and the list alike. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
  </Style>

  <Style Selector="ListBox.records">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8,0"/>
  </Style>

  <Style Selector="ComboBox.toolbar">
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="10,2"/>
  </Style>
</Styles>
