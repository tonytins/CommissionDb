<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Commis.Desktop"
        xmlns:records="using:Commis.Desktop.Records"
        x:Class="Commis.Desktop.MainWindow"
        Width="1040" Height="640" MinWidth="760" MinHeight="440"
        Background="{DynamicResource PanelBrush}"
        FontSize="14">
  <Window.Resources>
    <!--
      Where the bar is the title bar on Linux, Avalonia draws the window's frame so the window manager doesn't add its
      own title bar above. The frame keeps its edges for resizing and draws nothing else. Adapted from Roundhouse, by
      way of Depot and S1PK.
    -->
    <ControlTheme x:Key="FrameOnly" TargetType="WindowDrawnDecorations">
      <Setter Property="DefaultTitleBarHeight" Value="36"/>
      <Setter Property="DefaultFrameThickness" Value="4"/>
      <Setter Property="DefaultShadowThickness" Value="0"/>
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate>
          <WindowDrawnDecorationsContent/>
        </WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <DockPanel>
    <!-- The bar: the title, the toolbar, and the window's buttons, in one strip. -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="36"
            Background="{DynamicResource TitleBarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="12,0,10,0" IsHitTestVisible="False"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <Button x:Name="AddButton" Classes="toolbar" IsEnabled="False"/>
          <ComboBox x:Name="FilterBox" Classes="toolbar" MinWidth="130"
                    SelectionChanged="OnFilterChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:FilterOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="ExportButton" Classes="toolbar" IsEnabled="False"/>
        </StackPanel>

        <!-- Windows-style buttons, drawn where Commis draws the frame itself. -->
        <StackPanel x:Name="WindowButtons" Grid.Column="2" Orientation="Horizontal" IsVisible="False">
          <Button x:Name="MinimizeButton" Theme="{StaticResource CaptionButton}" Click="OnMinimizeClicked">
            <Path Data="M0,5 L10,5" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" Width="10" Height="10"/>
          </Button>
          <Button x:Name="MaximizeButton" Theme="{StaticResource CaptionButton}" Click="OnMaximizeClicked">
            <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Stroke="{DynamicResource TextBrush}"
                  StrokeThickness="1" Width="10" Height="10"/>
          </Button>
          <Button x:Name="CloseButton" Classes="caption close" Theme="{StaticResource CaptionButton}"
                  Click="OnCloseClicked">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1"
                  Width="10" Height="10"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The places: commissions, YCH, and raffles. -->
    <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8">
      <ListBox x:Name="SectionList" Classes="sections" SelectionChanged="OnSectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:SectionItem">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Name}"/>
              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Count}" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Where the database is, for when it isn't the one you expected. -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="DatabaseText" Classes="secondary" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </Border>

    <!-- Something that went wrong, in commis's own words, above whatever was showing. -->
    <Border x:Name="ProblemBar" DockPanel.Dock="Top" IsVisible="False" Padding="16,8"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer MaxHeight="96" VerticalAlignment="Center">
          <SelectableTextBlock x:Name="ProblemText" Classes="problem"/>
        </ScrollViewer>
        <Button x:Name="DismissButton" Grid.Column="1" Classes="toolbar" Margin="12,0,0,0" Click="OnDismissProblem"/>
      </Grid>
    </Border>

    <Panel>
      <!-- Commissions and YCH: the list, and the selected record beside it. -->
      <Grid x:Name="RecordsView" ColumnDefinitions="*,320">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,80,96,100" Margin="20,12,12,6">
            <TextBlock x:Name="ClientHeader" Classes="header"/>
            <TextBlock x:Name="TitleHeader" Grid.Column="1" Classes="header"/>
            <TextBlock x:Name="FeeHeader" Grid.Column="2" Classes="header" HorizontalAlignment="Right"/>
            <TextBlock x:Name="StatusHeader" Grid.Column="3" Classes="header" Margin="16,0,0,0"/>
            <TextBlock x:Name="DateHeader" Grid.Column="4" Classes="header"/>
          </Grid>
          <Panel>
            <ListBox x:Name="RecordList" Classes="records" SelectionChanged="OnRecordChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="records:RecordRow">
                  <Grid ColumnDefinitions="*,*,80,96,100">
                    <TextBlock Text="{Binding Client}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Fee}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{Binding Status}" Margin="16,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding Date}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Classes="secondary" IsVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Panel>
        </DockPanel>

        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,16">
          <Panel>
            <TextBlock x:Name="NoSelectionText" Classes="secondary" TextWrapping="Wrap"/>
            <ScrollViewer x:Name="DetailView" IsVisible="False">
              <StackPanel Spacing="10">
                <SelectableTextBlock x:Name="DetailClient" Classes="title" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="8">
                  <TextBlock x:Name="StatusLabel" Classes="label" VerticalAlignment="Center"/>
                  <ComboBox x:Name="StatusBox" Grid.Column="1" HorizontalAlignment="Stretch"
                            SelectionChanged="OnStatusChosen">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="local:FilterOption">
                        <TextBlock Text="{Binding Label}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock x:Name="FeeLabel" Grid.Row="1" Classes="label"/>
                  <SelectableTextBlock x:Name="DetailFee" Grid.Row="1" Grid.Column="1"/>
                  <TextBlock x:Name="TitleLabel" Grid.Row="2" Classes="label"/>
                  <SelectableTextBlock x:Name="DetailTitle" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DetailSlotLabel" Grid.Row="3" Classes="label"/>
                  <SelectableTextBlock x:Name="DetailSlot" Grid.Row="3" Grid.Column="1"/>
                  <TextBlock x:Name="ReferenceLabel" Grid.Row="4" Classes="label"/>
                  <SelectableTextBlock x:Name="DetailReference" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DescriptionLabel" Grid.Row="5" Classes="label"/>
                  <SelectableTextBlock x:Name="DetailDescription" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"/>
                  <TextBlock x:Name="AddedLabel" Grid.Row="6" Classes="label"/>
                  <SelectableTextBlock x:Name="DetailDate" Grid.Row="6" Grid.Column="1"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </Border>
      </Grid>

      <!-- Raffles: present, but honest that the window can't do them yet. -->
      <StackPanel x:Name="RafflesView" IsVisible="False" Spacing="6" Margin="20,16" MaxWidth="520"
                  HorizontalAlignment="Left">
        <TextBlock x:Name="RafflesTitle" Classes="title"/>
        <TextBlock x:Name="RafflesBody" Classes="secondary"/>
      </StackPanel>

      <!-- Nothing to show at all, such as when commis can't be found. -->
      <TextBlock x:Name="UnavailableText" Classes="secondary" IsVisible="False" Margin="20,16"/>
    </Panel>
  </DockPanel>
</Window>
